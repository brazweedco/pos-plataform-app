{
  "doc": "BrazWeed POS is a point of sale application for iOS, Android, and Web, built with Expo and React Native.",
  "name": "BrazWeed POS",
  "version": "1.0.0",
  "platforms": ["ios", "android", "web"],
  "stack": {
    "framework": "Expo SDK 54 with Expo Router v6",
    "language": "TypeScript",
    "ui": "React Native 0.81, React 19, react-native-web, NativeWind, Tailwind CSS",
    "animations": "react-native-reanimated",
    "state": "Zustand",
    "dataFetching": "TanStack React Query",
    "payments": ["@stripe/stripe-react-native", "@stripe/stripe-terminal-react-native (Tap to Pay)"],
    "navigation": ["expo-router", "@react-navigation/bottom-tabs"]
  },
  "structure": {
    "app": "Expo Router screens (file-based routing)",
    "components": "Reusable UI components",
    "constants": "Colors, fonts, layout and theme constants",
    "hooks": "Custom hooks (checkout, products, brands, categories, session, scaling, theme)",
    "providers": "React context providers (React Query)",
    "services": "API client, auth, cart, products, sales, storage and Stripe integrations",
    "stores": "Zustand stores (cart, product, user)",
    "types": "Shared TypeScript types (brand, cart, category, product, sale)",
    "utils": "Error handling, validation, navigation and formatting helpers",
    "assets": "Images and fonts (Foundry Context)",
    "docker": "Docker configuration",
    "scripts": "Project scripts (e.g. reset-project)"
  },
  "screens": [
    { "route": "/", "file": "app/index.tsx", "description": "Splash screen" },
    { "route": "/login", "file": "app/login.tsx", "description": "Login (email/password, biometric option)" },
    { "route": "/home", "file": "app/home.tsx", "description": "Home dashboard" },
    { "route": "/products", "file": "app/products.tsx", "description": "Product listing" },
    { "route": "/product", "file": "app/product/", "description": "Product details" },
    { "route": "/product-create", "file": "app/product-create.tsx", "description": "Create product" },
    { "route": "/product-edit", "file": "app/product-edit/", "description": "Edit product" },
    { "route": "/inventory", "file": "app/inventory.tsx", "description": "Inventory management" },
    { "route": "/cart", "file": "app/cart.tsx", "description": "Shopping cart" },
    { "route": "/checkout", "file": "app/checkout.tsx", "description": "Checkout and payment" },
    { "route": "/checkout-success", "file": "app/checkout-success.tsx", "description": "Successful checkout confirmation" },
    { "route": "/orders", "file": "app/orders.tsx", "description": "Order history" },
    { "route": "/settings", "file": "app/settings.tsx", "description": "App settings" }
  ],
  "api": {
    "baseUrl": "http://localhost:8080",
    "endpoints": [
      { "method": "POST", "path": "/api/v1/auth/login", "body": { "email": "string", "password": "string" }, "response": "{ accessToken, refreshToken, user }" },
      { "method": "POST", "path": "/api/v1/auth/refresh", "body": { "refreshToken": "string" }, "response": "{ accessToken, refreshToken, user }" }
    ],
    "auth": "Automatic token refresh on 401 responses"
  },
  "design": {
    "referenceSize": "440x956",
    "colors": {
      "primary": "#E46C45",
      "primaryDark": "#CF4A22",
      "secondary": "#003640",
      "background": "#FEF9F3",
      "surface": "#FFFFFF",
      "inputBackground": "#F7F5F3",
      "text": "#0F2F38",
      "textMuted": "#808080"
    },
    "fonts": {
      "regular": "FoundryContextW03-Regular",
      "medium": "FoundryContextW03-Demi",
      "semiBold": "FoundryContextW03-Demi",
      "bold": "FoundryContextW03-Bold",
      "extraBold": "FoundryContextW03-ExtraBold"
    },
    "scaling": {
      "hook": "useScale",
      "helpers": { "s": "uniform (fonts, icons, radius)", "sx": "horizontal", "sy": "vertical" }
    },
    "responsive": {
      "mobile": "Full-width layout",
      "largeScreen": "Centered 440px frame above 480px width"
    }
  },
  "commands": {
    "start": "npm start",
    "android": "npm run android",
    "ios": "npm run ios",
    "web": "npm run web",
    "lint": "npm run lint",
    "resetProject": "npm run reset-project",
    "fixDeps": "npm run fix-deps"
  },
  "setup": [
    "npm install",
    "npx expo start"
  ],
  "permissions": {
    "ios": ["Location (Tap to Pay)", "Bluetooth (card readers)", "NFC (payment cards)"],
    "android": ["NFC", "ACCESS_FINE_LOCATION"]
  },
  "links": {
    "figma": "https://www.figma.com/design/surOePAdNbB359u6Mky6dS/BrazeWeed-POS"
  }
}
